#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

// 반복문을 깨기 위해서 break를 사용했는데 무한반복되어버리는 오류가 발생함. 
// 종료코드로 오류는 간단하게 해결했지만 왜 이렇게 됐는지 물어봐야함
int run_menu();
int electric_charge(int use) ;

int main() 
{
	return run_menu();
}

/*
  함수명 : int run_menu()
  기능설명 : 사용자로부터 전기사용량을 입력받아 전기료를 출력하는 함수
  입력 : 없음
  반환 : 0 (성공) 0이 아닌 값 (오류코드)
*/
int run_menu()
{

       int use;

	while (1) {
		printf("월 사용량(kWh)? ");
		scanf("%d", &use);

		if (use < 0) {
			break;
		}

		printf("전기 요금: %d원\n", electric_charge(use));
	}

	return 0;
}
/*
  함수명 : int electric_charge(int use) 
  기능설명 : 전기 사용량을 입력받아 전기료를 반환하는 함수. 규칙은 기본료 + 초과사용량에 대한 요금
  입력 : 사용량
  반환 : 0이상은 정상계산된 전기료. 음수는 오류 코드.
*/
int electric_charge(int use) 
{

	double base; // 기본요금
	double surcharge; // 초과요금

	if (use <= 200) {
		surcharge = use * 93.3;
		base = 910;
	}
	else if (200 < use <= 400) {
		use -= 200;
		surcharge = use * 187.9 + (200 * 93.3);
		base = 1600;
	}
	else {
		use -= 400;
		surcharge = (use * 280.6 + (200 * 93.3) + (200 * 187.9));
		base = 7300;
	}

	return (int) (surcharge + base);

}
